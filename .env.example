# webcap environment (copy to .env and fill in)

# Chain: base | base-sepolia | local
#   base         -> Base mainnet USDC  (LIVE, real money)
#   base-sepolia -> Base Sepolia USDC  (testnet, default)
#   local        -> local Anvil + mintable USDC (deterministic tests / local surface)
WEBCAP_CHAIN=local

# HTTP port (default 8080)
WEBCAP_PORT=8080

# Merchant self-custody EOA private key (0x-prefixed 32-byte hex). The server
# RECEIVES USDC to the address derived from this key. Never commit a real key.
USDC_MERCHANT_PRIVATE_KEY=

# Fallback when USDC_MERCHANT_PRIVATE_KEY is empty: the merchant address USDC
# is expected at. One of the two is required to start (server refuses '' ).
WEBCAP_MERCHANT_ADDRESS=

# Only used when WEBCAP_CHAIN=local:
#   RPC endpoint (default http://127.0.0.1:8545)
WEBCAP_RPC_URL=http://127.0.0.1:8545
#   Address of the mintable USDC deployed by scripts/devchain.ts
#   (written to /tmp/webcap-chain.json; LOCAL_USDC_CONTRACT is an alias)
WEBCAP_USDC_ADDRESS=

# Poller cadence in ms (default 30000; keep <=1000 for manual local testing)
POLL_INTERVAL_MS=30000

# Database file (WAL). Relative paths resolve from the project root.
WEBCAP_DB=./data/webcap.db

# Optional: extra hosts the capture endpoint may load despite the private-IP
# guard (comma-separated), e.g. "127.0.0.1,localhost" for local fixtures.
WEBCAP_CAPTURE_ALLOW_HOSTS=

# --- x402 per-request USDC payment (POST /v1/x402/capture) ---
# Enabled automatically when WEBCAP_CHAIN=base-sepolia or base (CAIP-2
# eip155:84532 / eip155:8453). With WEBCAP_CHAIN=local the route returns 503.
# The payer EOA signs a gasless EIP-3009 transferWithAuthorization; the
# facilitator submits the on-chain USDC transfer and pays gas.

# Price per capture in human USDC ("0.001" = 1000 atomic 6-decimal units).
# Default 0.001
WEBCAP_X402_PRICE_USDC=0.001

# Facilitator URL (verify + settle).
#   base-sepolia: https://x402.org/facilitator (permissionless, default)
#   base mainnet: https://api.cdp.coinbase.com/platform/v2/x402 (CDP, needs key)
X402_FACILITATOR_URL=https://x402.org/facilitator

# CDP Bazaar / mainnet facilitator (optional) — enables CDP facilitator auth + Bazaar listing
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Optional overrides (defaults: chain USDC address / merchant address).
WEBCAP_X402_ASSET=
WEBCAP_X402_PAY_TO=

# --- x402 extract + P&L ledger + optional model extraction ---

# Price per extract in human USDC (the "meaning" price, above raw capture).
# Default 0.01
WEBCAP_X402_EXTRACT_PRICE_USDC=0.01

# Amortized compute cost per page-load in human USDC, recorded to the P&L
# ledger (revenue vs. cost vs. net margin). Set this to your real infra/TPU
# cost. Default 0.0002
WEBCAP_COMPUTE_COST_USDC_PER_REQUEST=0.0002

# Rolling free allowance: free product calls per caller IP per window, with no
# wallet, signature or account. This is growth spend to seed usage — budget it
# against WEBCAP_COMPUTE_COST_USDC_PER_REQUEST above (50 calls/IP/day is about
# $0.01 of compute per IP per day). 0 disables the free rail and every call
# returns the x402 402 challenge.
WEBCAP_ALLOWANCE_CALLS=50
WEBCAP_ALLOWANCE_WINDOW_HOURS=24
# Fleet-wide free-call circuit breaker per window. When the window total reaches
# this, free usage stops for everyone (callers still get a payable 402). This is
# a runaway-spend guard, not a policy cap. 0 disables the breaker.
WEBCAP_ALLOWANCE_GLOBAL_LIMIT=20000

# Optional model-based extraction (any OpenAI-compatible /chat/completions
# endpoint). Leave empty for deterministic-only extraction (always available).
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# --- Persistent artifact store (public screenshot links) ---

# Public base URL of this deployment (scheme + host, no trailing path), e.g.
# https://webcap.shoutsid.fyi. Every capture returns
# artifact.url = <this>/v1/artifacts/<id> — a persistent, no-auth public link
# to the stored screenshot. Required: the server refuses to start without it.
WEBCAP_PUBLIC_BASE_URL=

# Fallback edge URL (e.g. a stable ngrok domain) kept alive so old links and
# indexer registrations keep working after the primary domain moves.
# Optional: when set, bin/ngrok-watchdog.sh guards this URL instead of the primary.
# WEBCAP_FALLBACK_URL=https://your-host.ngrok-free.dev

# --- Tuning (all optional; defaults = production behavior, no need to set) ---

# Free preview budget: requests/min/peer IP (default 10).
# WEBCAP_PREVIEW_RATE_LIMIT=10

# Fastify server limits (base64 capture artifacts need body headroom):
# request timeout (default 120000 ms), max request body (default 2000000 bytes).
# WEBCAP_REQUEST_TIMEOUT_MS=120000
# WEBCAP_BODY_LIMIT_BYTES=2000000

# Capture: page-load timeout when the client sends none (default 30000 ms) and
# the cap applied to a client-specified timeoutMs (default 60000 ms).
# WEBCAP_CAPTURE_TIMEOUT_MS=30000
# WEBCAP_CAPTURE_TIMEOUT_CAP_MS=60000

# Model extraction fetch timeout (default 30000 ms).
# WEBCAP_MODEL_TIMEOUT_MS=30000

# x402 challenge maxTimeoutSeconds (default 300000 ms).
# WEBCAP_X402_MAX_TIMEOUT_MS=300000

# Watch webhooks: attempts (default 3) and per-attempt timeout (default 5000 ms).
# WEBCAP_WEBHOOK_RETRIES=3
# WEBCAP_WEBHOOK_TIMEOUT_MS=5000

# Credits API: invoice expiry window (default 3600000 ms = 1 h) and credits
# granted by POST /v1/invoice when the body omits `credits` (default 100).
# WEBCAP_INVOICE_TTL_MS=3600000
# WEBCAP_DEFAULT_CREDITS=100

# Free preview slice sizes: headings (5), links (10), markdown chars (1500;
# mirrored in the OpenAPI doc).
# WEBCAP_PREVIEW_HEADINGS_LIMIT=5
# WEBCAP_PREVIEW_LINKS_LIMIT=10
# WEBCAP_PREVIEW_MARKDOWN_LIMIT=1500

# CDP Bazaar catalog link on the landing page (default https://cdp.coinbase.com).
# WEBCAP_BAZAAR_CATALOG_URL=https://cdp.coinbase.com

# Artifact store sweep: delete artifacts older than N days (0 = disabled,
# the default). When enabled the service purges on a 6-hourly timer.
# WEBCAP_ARTIFACT_RETENTION_DAYS=0

# Optional owner contact email — surfaced as info.contact.email in /openapi.json for directory ownership verification (e.g. mppscan/Poncho).
# WEBCAP_CONTACT_EMAIL=

# 402index domain-ownership proof. Claim the domain once
#   curl -X POST https://402index.io/api/v1/claim -H 'content-type: application/json' -d '{"domain":"<host>"}'
# then set WEBCAP_402INDEX_VERIFY_HASH to the returned verification_hash: it is
# served verbatim at /.well-known/402index-verify.txt so the registry verifies
# the domain and approves listings. The verification_token is an edit credential
# (keep it private, .env only). Unset = the well-known file 404s.
# WEBCAP_402INDEX_VERIFY_HASH=
# WEBCAP_402INDEX_VERIFICATION_TOKEN=

# --- MPP (Machine Payments Protocol, Tempo / draft-ryan-httpauth-payment-01) ---
# The 3 paid 402s additionally carry a `WWW-Authenticate: Payment ...`
# challenge (same price terms as the x402 challenge) so MPP-first directories
# (mppscan) can list them. Disabled by default: unset/empty = x402-only.
#
# Generate a fresh secret (>= 32 bytes decoded):
#   openssl rand -base64 32
# The value may be a raw UTF-8 passphrase or hex (0x optional); it MUST decode
# to >= 32 bytes or the server refuses to start. Realm = the bare host of
# WEBCAP_PUBLIC_BASE_URL (scheme + host, no path). Full detail: docs/MPP.md.
# WARNING: never commit a real secret — .env is gitignored, keep it that way.
# MPP_SECRET_KEY=<paste `openssl rand -base64 32` output here>

# --- Discovery keepalive (bin/webcap-keepalive.sh, weekly cron) ---
# Payer EOA for the $0.001 self-settlement that keeps the CDP Bazaar listing
# alive (resources with no settlement for 30 days are delisted). The funds
# loop back to the merchant wallet; while this wallet holds no USDC the
# attempt is a no-op (logged, nonfatal).
# X402_CUSTOMER_PRIVATE_KEY=

# --- Stripe (fiat payments) ---
# Optional: enables credit pack purchases via card (Stripe Checkout).
# When set, POST /v1/stripe/checkout creates a Checkout Session for credit packs.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
